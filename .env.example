# ─── Better Auth ───────────────────────────────────────────────────────────────
# Encryption secret (min 32 chars). Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=your_generated_secret_here
# Base URL of the app (no trailing slash). Also the issuer and audience of the JWTs the
# backend verifies (backend JWT_ISSUER / JWT_AUDIENCE must match it exactly).
BETTER_AUTH_URL=http://localhost:3000

# ─── Google OAuth (Better Auth) ─────────────────────────────────────────────────
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Resend (auth OTP emails) ───────────────────────────────────────────────────
# Server-only, RUNTIME env vars — never NEXT_PUBLIC_*.
RESEND_API_KEY=re_your_key
# Deliberately UNQUOTED: dotenv strips quotes locally but Coolify/Docker pass the
# raw string through, and Resend then 422s on the `from` field. The domain must
# exactly match a verified domain in Resend.
RESEND_FROM_EMAIL=FitFusion <noreply@verification.zeeshanai.cloud>

# ─── Database (Postgres) ────────────────────────────────────────────────────────
# Better Auth tables are created in the fit_fusion schema (via search_path).
DATABASE_URL=postgres://user:password@host:5432/dbname

# ─── FitFusion API (FastAPI backend in backend/) ───────────────────────────────
# Base URL of the API, no trailing slash, no /v1. The browser calls it directly with a
# short-lived JWT from Better Auth (/api/auth/token). NEXT_PUBLIC_*: must be present at
# BUILD time. The API's CORS_ORIGINS must include this app's origin.
# Local: uv run uvicorn app.main:create_app --factory --port 8010 (in backend/); 8000 is often taken
NEXT_PUBLIC_API_URL=http://localhost:8010

# ─── n8n (contact form only) ───────────────────────────────────────────────────
# Plans and credits no longer go through n8n. Only the /contact route still posts
# to an n8n webhook; N8N_API_KEY is sent as its x-api-key header.
N8N_API_KEY=your_n8n_api_key_here
# n8n webhook the /contact form posts to
N8N_CONTACT_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-contact-id

# ─── Upstash Redis (contact-form rate limiting) ─────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ─── Umami Analytics ────────────────────────────────────────────────────────────
# Must be present at BUILD time (NEXT_PUBLIC_* are inlined into the client bundle).
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://your-umami-host/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id
