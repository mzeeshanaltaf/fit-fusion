# FitFusion API: copy to backend/.env for local runs (gitignored). In production these are
# set as environment variables in Coolify.

# ─── Database ──────────────────────────────────────────────────────────────────
# Same Postgres as the Next.js app; tables live in the `fit_fusion` schema (search_path is
# set by the app, so do NOT add it here). postgres:// and postgresql:// both work.
# On the VPS use the internal host 10.0.0.1:5432, not the public IP.
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ─── Auth: Better Auth `jwt` plugin (issued by the Next.js app) ────────────────
# JWKS_URL    = <BETTER_AUTH_URL>/api/auth/jwks
# JWT_ISSUER  = JWT_AUDIENCE = BETTER_AUTH_URL exactly (no trailing slash); set in src/lib/auth.ts
JWKS_URL=http://localhost:3000/api/auth/jwks
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=http://localhost:3000
# Optional tuning
# JWT_LEEWAY_SECONDS=10
# JWKS_CACHE_TTL_SECONDS=3600
# JWKS_REFRESH_COOLDOWN_SECONDS=10

# ─── App ───────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,https://fitfusion.zeeshanai.cloud
# Protects /v1/admin/* (sent in the X-API-Key header). Empty = those routes answer 404.
# Generate: openssl rand -hex 32
ADMIN_API_KEY=
# Free credits granted to each new verified user.
SIGNUP_CREDITS=10

# ─── AI (OpenAI Responses API) ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-6-luna
OPENAI_SERVICE_TIER=flex
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=900
# Tier to retry on when flex has no capacity, e.g. `auto`. Empty = no retry.
OPENAI_FLEX_FALLBACK_TIER=
# Swap / regenerate run inside the HTTP request, so they get a shorter deadline than a
# generation job. On timeout nothing changes and no edit is used. A day takes ~25 s on flex.
EDIT_TIMEOUT_SECONDS=120
